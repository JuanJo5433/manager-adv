generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id          String    @id @default(uuid())
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  document    String?   @unique
  email       String?   @unique
  name        String
  observation String?
  phone       String?
  Process     Process[]

  @@map("clients")
}
model Users {
  id        String         @id @default(uuid())
  name      String?
  username  String?
  email     String         @unique
  password  String
  rol       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  processes ProcessUsers[] // Relación muchos a muchos con Process
  Task      Task[]
  comments  Comments[]

  @@map("users")
}
model Process {
  id        String             @id @default(uuid())
  title     String
  slug      String             @unique
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id])
  users     ProcessUsers[]     // Relación muchos a muchos con Users
  products  ProcessProducts[]  // Relación muchos a muchos con Products
  status    Int                @default(0) // 0=Pendiente, 1=En desarrollo, 2=Completado
  tasks     Task[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("process")
}



model ProcessUsers {
  id        String   @id @default(uuid())
  processId String
  userId    String
  process   Process  @relation(fields: [processId], references: [id])
  user      Users    @relation(fields: [userId], references: [id])

  @@unique([processId, userId]) // Asegura que no se repitan combinaciones de usuario y proceso
  @@map("process_users")
}


model ProcessProducts {
  id         String   @id @default(uuid())
  processId  String
  productId  String
  process    Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  product    Products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([processId, productId]) // Evita duplicados en la relación
  @@map("process_products")
}

model Products {
  id            String             @id @default(uuid())
  name          String
  description   String?
  price         Float
  discount      Float?
  imageUrl      String?
  availability  Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  productTypeId String
  productType   ProductType         @relation(fields: [productTypeId], references: [id])
  processes     ProcessProducts[]   // Relación muchos a muchos con Process

  @@map("products")
}


model ProductType {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  Products  Products[]

  @@map("product_types")
}


model Task {
  id          String    @id @default(uuid())
  title       String // Ejemplo: "Confirmar vuelo"
  description String?
  processId   String
  process     Process   @relation(fields: [processId], references: [id])
  userId      String
  user        Users     @relation(fields: [userId], references: [id]) // "Pendiente", "En progreso", "Completado"
  deadline    DateTime?
  status      Int // 0=pendiente, 1=en progreso, 2=Completado, 3=Cancelado 
  priority    String // "Alta", "Media", "Baja"
  comments    Comments[]
  createdAt   DateTime  @default(now())

  @@map("task")
}


model Comments {
  id        String   @id @default(uuid())
  text      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  userId    String
  user      Users    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@map("comments")
}
model Suppliers {
  id                 String    @id @default(uuid())
  name               String
  nameRepresentative String?
  nit                String    @unique 
  description        String
  email             String?
  phone             String?
  urlWeb            String?
  conditions        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  supplierTypes     SuppliersSupplierTypes[] // Relación muchos a muchos con SupplierType

  @@map("suppliers")
}

model SupplierType {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  suppliers SuppliersSupplierTypes[] // Relación muchos a muchos con Suppliers

  @@map("supplier_type")
}

model SuppliersSupplierTypes {
  id             String       @id @default(uuid())
  supplierId     String
  supplierTypeId String
  supplier       Suppliers    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierType   SupplierType @relation(fields: [supplierTypeId], references: [id], onDelete: Cascade)

  @@unique([supplierId, supplierTypeId]) // Evita duplicados en la relación
  @@map("suppliers_supplier_types")
}
